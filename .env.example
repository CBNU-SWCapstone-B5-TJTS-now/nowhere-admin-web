# 이 파일을 .env 로 복사해서 사용하세요.

# 비워두면 https://api.nowhere-app.cloud 를 기본값으로 사용합니다.
VITE_API_BASE_URL=https://api.nowhere-app.cloud

# 로컬 백엔드로 테스트할 때는 아래처럼 바꾸세요.
# VITE_API_BASE_URL=http://localhost:8080

# ---- 관리자 마스터 계정 (백엔드 인증 API 준비 전까지 사용) ----
# 여기 값을 바꾸면 코드 수정 없이 로그인 계정을 바꿀 수 있어요.
# 비워두면 admin@nowhere-app.cloud / admin1234 가 기본값입니다.
VITE_ADMIN_EMAIL=admin@nowhere-app.cloud
VITE_ADMIN_PASSWORD=admin1234
VITE_ADMIN_NAME=관리자
